# Danh sách key credential (KHÔNG có giá trị) — điền giá trị thật ở automation_test/.env.

# ── Web login — autotest-rf-web
# chỉ điền nếu app web cần đăng nhập; nhiều role -> thêm WEB_<ROLE>_USERNAME/_PASSWORD
WEB_USERNAME=
WEB_PASSWORD=

# ── API login — autotest-rf-api
# USERNAME/PASSWORD cho endpoint login, hoặc API_KEY nếu auth bằng API key
API_USERNAME=
API_PASSWORD=
API_KEY=

# ── App login — autotest-rf-android / autotest-rf-ios
# tài khoản đăng nhập app; nhiều role -> APP_<ROLE>_USERNAME/_PASSWORD
APP_USERNAME=
APP_PASSWORD=

# ── Device farm — autotest-rf-android / autotest-rf-ios
# chỉ điền nếu chạy trên device farm (MCloud)
FARM_USERNAME=
FARM_ACCESS_KEY=

# ── Database — autotest-rf-db
# chỉ điền nếu TC có kiểm tra/chuẩn bị dữ liệu DB
DB_USER=
DB_PASS=

# ── SSH tunnel tới DB — autotest-rf-db
# chỉ điền nếu DB phải đi qua SSH tunnel; DB_TUNNEL_SSH_KEY = đường dẫn file private key
DB_TUNNEL_SSH_USER=
DB_TUNNEL_SSH_KEY=

# ── OTP — TOTP secret
# chỉ điền nếu TC có bước OTP dạng TOTP (Google Authenticator)
TOTP_SECRET=

# ── Proxy công ty — autotest-rf-web
# chỉ điền nếu proxy ra internet cần đăng nhập (URL proxy không kèm user/pass nằm ở global-data.md)
PROXY_USERNAME=
PROXY_PASSWORD=
